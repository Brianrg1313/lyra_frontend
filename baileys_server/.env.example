# Control API (consumed by the Lyra desktop app, localhost only)
HOST=127.0.0.1
PORT=4001
CONTROL_API_KEY=change-me-to-a-long-random-value

# Lyra backend (scheme, host and port, no path). Only a fallback: the desktop
# app pushes this address together with the user session this server acts as
# (PUT /backend), because the two come from the same place. Leave it empty to
# run session management and QR pairing on their own, with nothing relayed.
#
# There is no API key for the backend and there is nothing to put here for it:
# the credential is the app's own session, which only the app can supply.
BACKEND_URL=

# Largest attachment forwarded to the backend, in decoded bytes. The backend
# parses at most 1 MB of JSON and base64 costs a third on top, so this sits
# below what its parser would refuse outright. A bigger picture is still
# forwarded as a message, just without its bytes.
BACKEND_MEDIA_MAX_BYTES=655360

# Storage
DATA_DIR=./data

# Logging: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# Media inlined in message.received events as base64 up to this size (bytes).
# Anything larger is announced with its metadata only (mimetype, size), no data.
MEDIA_INLINE_MAX_BYTES=1048576
